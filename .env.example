# =========================================================
# This project uses TWO separate .env files:
#
# 1. server/.env  -> Backend configuration (MongoDB, JWT, port)
#    See server/.env.example for the full template with
#    MongoDB Atlas (cloud) setup instructions.
#
# 2. client/.env   -> Frontend configuration (API base URL)
#    See client/.env.example for the template.
#
# Copy each example file to .env in its respective folder
# before running the project. This root file is provided
# only as a quick reference / overview.
# =========================================================

# ---- server/.env ----
# MongoDB Atlas (cloud) example:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/student_management_system?retryWrites=true&w=majority
# Or local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/student_management_system

PORT=5000
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# ---- client/.env ----
REACT_APP_API_URL=http://localhost:5000/api
