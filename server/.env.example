# =========================================================
# MongoDB Connection
# =========================================================
# Option A: Local MongoDB (requires MongoDB installed & running on your machine)
# MONGO_URI=mongodb://127.0.0.1:27017/student_management_system

# Option B: MongoDB Atlas (cloud) - recommended, no local install needed
# 1. Create a free cluster at https://mongodb.com/cloud/atlas
# 2. Create a Database User (Database Access) and copy the password
# 3. Allow your IP under Network Access (or 0.0.0.0/0 for testing)
# 4. Get the connection string from Database -> Connect -> Drivers -> Node.js
# 5. Paste it below, replacing <username>, <password>, and adding your DB name
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/student_management_system?retryWrites=true&w=majority

# Note: if your password contains special characters (@ / : # ? etc.),
# URL-encode them, e.g. @ becomes %40

# =========================================================
# Server
# =========================================================
# Port for the backend server
PORT=5000

# =========================================================
# JWT Authentication
# =========================================================
# JWT secret key - use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# =========================================================
# CORS
# =========================================================
# Comma-separated list of allowed origins for CORS
CLIENT_URL=http://localhost:3000
